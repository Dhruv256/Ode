{
  "name": "birthday-world-generator",
  "version": "0.1.0",
  "private": true,
  "description": "A curated generator for interactive, art-directed birthday websites.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "next build && next start",
    "typecheck": "tsc --noEmit",
    "qa:templates": "node scripts/template-structure-audit.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:qa": "node scripts/qa-server.mjs",
    "db:studio": "node scripts/repair-studio-schema.mjs",
    "test:hamper:live": "vitest run --config vitest.live.config.ts"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    }
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "framer-motion": "^11.11.9",
    "next": "^14.2.15",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}

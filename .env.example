# Use Supabase's pooled PostgreSQL connection in Vercel and locally.
# Keep the real value in .env.local / Vercel Environment Variables only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The modern Supabase key names are supported. The publishable key is not used
# by the server upload flow, but may be used by future browser features.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Only needed for server-side signed Storage uploads. Never expose this value.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Legacy aliases also work if your project still uses them:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_CLERK_ENABLED=false
